<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="robot_arm_world">

    <!-- ─── Physics ─────────────────────────────────────────────────── -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ─── Sun ─────────────────────────────────────────────────────── -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ─── Ground plane ────────────────────────────────────────────── -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ─── Table ───────────────────────────────────────────────────── -->
    <!-- A simple box table (0.6 x 0.6 x 0.7 m) placed in front of the robot -->
    <model name="table">
      <static>true</static>
      <pose>0.5 0.0 0.35 0 0 0</pose>   <!-- centred at half-height -->

      <link name="table_link">
        <collision name="table_collision">
          <geometry>
            <box>
              <size>0.6 0.6 0.7</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="table_visual">
          <geometry>
            <box>
              <size>0.6 0.6 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>

        <inertial>
          <mass>10.0</mass>
          <inertia>
            <ixx>0.608</ixx>
            <iyy>0.608</iyy>
            <izz>0.060</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- ─── Scene ───────────────────────────────────────────────────── -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ─── Camera viewpoint ────────────────────────────────────────── -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.5 -1.5 1.2 0 0.35 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
