<?xml version="1.0"?>
<!-- =========================================================================
  robot_arm_gazebo.xacro
  Gazebo-specific settings: material colors, physics, and ROS plugins
  Included by robot_arm.urdf.xacro
========================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================================
       GAZEBO MATERIAL COLORS
       (Gazebo ignores URDF <material> tags; needs its own <gazebo> blocks)
  ==================================================================== -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="waist_link">
    <material>Gazebo/Black</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="shoulder_link">
    <material>Gazebo/Red</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="elbow_link">
    <material>Gazebo/Blue</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="wrist_pitch_link">
    <material>Gazebo/Grey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="wrist_roll_link">
    <material>Gazebo/Orange</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="gripper_base_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="gripper_finger_left">
    <material>Gazebo/White</material>
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <gazebo reference="gripper_finger_right">
    <material>Gazebo/White</material>
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <!-- ===================================================================
       GAZEBO ROS PLUGIN — Joint State Publisher
       Publishes all joint states to /joint_states topic
  ==================================================================== -->
  <gazebo>
    <plugin name="gazebo_ros_joint_state_publisher"
            filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>joint_states:=joint_states</remapping>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>joint1_waist</joint_name>
      <joint_name>joint2_shoulder</joint_name>
      <joint_name>joint3_elbow</joint_name>
      <joint_name>joint4_wrist_pitch</joint_name>
      <joint_name>joint5_wrist_roll</joint_name>
      <joint_name>joint6_gripper_left</joint_name>
      <joint_name>joint7_gripper_right</joint_name>
    </plugin>
  </gazebo>

  <!-- ===================================================================
       GAZEBO ROS PLUGIN — Joint Pose Trajectory
       Accepts joint position commands on /set_joint_trajectory topic
       Allows commanding joint angles without ros2_control
  ==================================================================== -->
  <gazebo>
    <plugin name="gazebo_ros_joint_pose_trajectory"
            filename="libgazebo_ros_joint_pose_trajectory.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

</robot>
